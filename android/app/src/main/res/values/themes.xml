<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: the app mark on the deepest surface, so launch → first frame
         never flashes a different colour. -->
    <style name="Theme.ScreenplayStudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070710</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#FF5F1F</item>
        <item name="postSplashScreenTheme">@style/Theme.ScreenplayStudio</item>
    </style>

    <style name="Theme.ScreenplayStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#070710</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
